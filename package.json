{
  "name": "recolor",
  "version": "1.0.0",
  "description": "Blog image theme converter — light/dark dual version, no system dependencies",
  "main": "index.js",
  "bin": { "recolor": "./index.js" },
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"node server.js\" \"pnpm --dir client dev\"",
    "build": "pnpm --dir client build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
